generator client {
  provider = "prisma-client"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TestSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QuestionStage {
  EXPLORATION
  DEEPENING
  CONTEXT
}

enum QuestionKind {
  LIKERT
  OPEN
}

enum OpenAnswerMode {
  OPEN
  FORCED_CHOICE
  GUIDED_REFLECTION
}

model Dimension {
  id            Int                     @id @default(autoincrement())
  code          String                  @unique @db.VarChar(80)
  name          String                  @db.VarChar(100)
  description   String?
  questions     Question[]
  sessionScores SessionDimensionScore[]
  profiles      ProfileDimension[]

  @@map("dimensions")
}

model Question {
  id              Int            @id @default(autoincrement())
  text            String
  kind            QuestionKind   @default(LIKERT)
  stage           QuestionStage  @default(EXPLORATION)
  trigger         String?        @db.VarChar(80)
  difficulty      Int            @default(1)
  isActive        Boolean        @default(true)

  model           String?        @db.VarChar(80)
  scaleType       String?        @db.VarChar(80)
  promptStyle     String?        @db.VarChar(80)
  contrastLabel   String?        @db.VarChar(150)
  semanticFocus   Json?
  optionalComment Boolean        @default(false)

  dimensionId     Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  dimension       Dimension?     @relation(fields: [dimensionId], references: [id])
  answers         TestAnswer[]
  openAnswers     TestOpenAnswer[]
  options         QuestionOption[]

  @@index([dimensionId])
  @@index([kind])
  @@index([stage])
  @@index([trigger])
  @@map("questions")
}

model QuestionOption {
  id            Int      @id @default(autoincrement())
  questionId    Int
  optionCode    String   @db.VarChar(120)
  text          String
  dimensionCode String?  @db.VarChar(80)
  semanticFocus Json?
  displayOrder  Int      @default(1)

  question      Question @relation(fields: [questionId], references: [id])

  @@unique([questionId, optionCode])
  @@index([questionId])
  @@index([dimensionCode])
  @@map("question_options")
}

model VocationalProfile {
  id          Int                @id @default(autoincrement())
  code        String             @unique @db.VarChar(100)
  name        String             @db.VarChar(150)
  description String?
  dimensions  ProfileDimension[]
  sessions    TestSession[]
  results     TestResult[]

  @@map("vocational_profiles")
}

model ProfileDimension {
  id          Int               @id @default(autoincrement())
  profileId   Int
  dimensionId Int
  weight      Decimal           @default(1.0) @db.Decimal(5, 2)

  profile     VocationalProfile @relation(fields: [profileId], references: [id])
  dimension   Dimension         @relation(fields: [dimensionId], references: [id])

  @@unique([profileId, dimensionId])
  @@map("profile_dimensions")
}

model TestSession {
  id                    String                  @id @default(uuid()) @db.Uuid
  participantCode       String?                 @db.VarChar(80)
  grade                 String?                 @db.VarChar(50)
  schoolCode            String?                 @db.VarChar(80)
  ageRange              String?                 @db.VarChar(20)
  consentAccepted       Boolean                 @default(false)
  isPilotData           Boolean                 @default(true)
  status                TestSessionStatus       @default(IN_PROGRESS)

  startedAt             DateTime                @default(now())
  finishedAt            DateTime?
  totalQuestions        Int                     @default(0)

  adaptivePhase         String?                 @db.VarChar(80)
  closingReason         String?                 @db.VarChar(120)
  consistencyScore      Decimal?                @db.Decimal(5, 2)
  profileClarityScore   Decimal?                @db.Decimal(5, 2)
  vocationalUncertainty Decimal?                @db.Decimal(5, 2)
  externalPressure      Decimal?                @db.Decimal(5, 2)
  broadInterestPattern  Boolean                 @default(false)
  lowCoreConfidence     Boolean                 @default(false)

  finalProfileId        Int?
  finalProfile          VocationalProfile?      @relation(fields: [finalProfileId], references: [id])

  answers               TestAnswer[]
  openAnswers           TestOpenAnswer[]
  scores                SessionDimensionScore[]
  result                TestResult?

  @@index([status])
  @@index([participantCode])
  @@index([isPilotData])
  @@index([closingReason])
  @@index([broadInterestPattern])
  @@map("test_sessions")
}

model TestAnswer {
  id               Int         @id @default(autoincrement())
  sessionId        String      @db.Uuid
  questionId       Int
  answerValue      Int
  questionOrder    Int

  comment          String?
  suspiciousInput  Boolean     @default(false)
  suspiciousReason String?

  answeredAt       DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  session          TestSession @relation(fields: [sessionId], references: [id])
  question         Question    @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@unique([sessionId, questionOrder])
  @@index([questionId])
  @@index([sessionId])
  @@map("test_answers")
}

model TestOpenAnswer {
  id                    Int            @id @default(autoincrement())
  sessionId             String         @db.Uuid
  questionId            Int
  trigger               String         @db.VarChar(80)
  answerText            String
  order                 Int

  answerMode            OpenAnswerMode @default(OPEN)
  selectedOptionId      String?        @db.VarChar(120)
  selectedDimensionCode String?        @db.VarChar(80)
  selectedSemanticFocus Json?

  careerReference       String?        @db.VarChar(150)
  observedMismatch      Boolean        @default(false)

  suspiciousInput       Boolean        @default(false)
  suspiciousReason      String?

  answeredAt            DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  session               TestSession    @relation(fields: [sessionId], references: [id])
  question              Question       @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@unique([sessionId, order])
  @@index([questionId])
  @@index([sessionId])
  @@index([answerMode])
  @@index([observedMismatch])
  @@map("test_open_answers")
}

model SessionDimensionScore {
  id                Int         @id @default(autoincrement())
  sessionId         String      @db.Uuid
  dimensionId       Int
  score             Int         @default(0)
  questionsAnswered Int         @default(0)
  averageScore      Decimal     @default(0) @db.Decimal(4, 2)

  session           TestSession @relation(fields: [sessionId], references: [id])
  dimension         Dimension   @relation(fields: [dimensionId], references: [id])

  @@unique([sessionId, dimensionId])
  @@map("session_dimension_scores")
}

model TestResult {
  id                   Int               @id @default(autoincrement())
  sessionId            String            @unique @db.Uuid
  predictedProfileId   Int

  confidenceScore      Decimal?          @db.Decimal(5, 2)
  profileClarityScore  Decimal?          @db.Decimal(5, 2)
  resultStabilityScore Decimal?          @db.Decimal(5, 2)

  recommendationText   String?
  modelUsed            String            @db.VarChar(100)
  resultPayload        Json?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  session              TestSession       @relation(fields: [sessionId], references: [id])
  predictedProfile     VocationalProfile @relation(fields: [predictedProfileId], references: [id])

  @@map("test_results")
}

model MlExperiment {
  id                Int                @id @default(autoincrement())
  modelName         String             @db.VarChar(100)
  datasetVersion    String             @db.VarChar(80)
  accuracy          Decimal            @db.Decimal(6, 4)
  precision         Decimal            @db.Decimal(6, 4)
  recall            Decimal            @db.Decimal(6, 4)
  f1Score           Decimal            @db.Decimal(6, 4)
  confusionMatrix   Json
  artifactPath      String?            @db.VarChar(255)
  datasetSnapshotId Int?
  trainedAt         DateTime           @default(now())

  datasetSnapshot   MlDatasetSnapshot? @relation(fields: [datasetSnapshotId], references: [id])

  @@index([datasetSnapshotId])
  @@map("ml_experiments")
}

model MlDatasetSnapshot {
  id             Int                 @id @default(autoincrement())
  version        String              @unique @db.VarChar(80)
  source         String              @db.VarChar(120)
  rowCount       Int                 @default(0)
  featureSchema  Json?
  labelPolicy    String?             @db.VarChar(120)
  notes          String?
  createdAt      DateTime            @default(now())

  features       MlTrainingFeature[]
  experiments    MlExperiment[]

  @@map("ml_dataset_snapshots")
}

model MlTrainingFeature {
  id                Int               @id @default(autoincrement())
  datasetSnapshotId Int
  sessionId         String?           @db.Uuid
  featureVector     Json
  finalProfileName  String?           @db.VarChar(150)
  careerReference   String?           @db.VarChar(150)
  expectedFamily    String?           @db.VarChar(150)
  expectedSubroute  String?           @db.VarChar(150)
  observedMismatch  Boolean           @default(false)
  split             String?           @db.VarChar(20)
  createdAt         DateTime          @default(now())

  datasetSnapshot   MlDatasetSnapshot @relation(fields: [datasetSnapshotId], references: [id])

  @@index([datasetSnapshotId])
  @@index([sessionId])
  @@index([observedMismatch])
  @@map("ml_training_features")
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(180)
  name         String    @db.VarChar(150)
  passwordHash String
  role         String    @default("ADMIN") @db.VarChar(40)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@index([isActive])
  @@map("admin_users")
}
